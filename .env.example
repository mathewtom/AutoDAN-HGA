# autodan/ — surrogate-transfer red-team harness for SecureRAG-Agent
# Copy to .env and fill in. .env is gitignored.

# Target: running SecureRAG-Agent service (Phase 3+ transfer phase).
# Start with `uv run uvicorn securerag_agent.api:app --host 127.0.0.1 --port 8000`
# from the SecureRAG-Agent repo.
SECURERAG_AGENT_URL=http://127.0.0.1:8000

# Surrogate: HuggingFace model ID or local path for Llama 3.1 8B.
# Requires accepting the Meta license on the HF model page first.
SURROGATE_MODEL_PATH=meta-llama/Llama-3.1-8B-Instruct

# ChromaDB: shared path with SecureRAG-Agent's populated Meridian corpus.
# The mock agent reads this directly — Phase 1 decides whether to clone
# to an isolated red-team collection to avoid contaminating the live index.
CHROMA_PATH=../../SecureRAG-Agent/data/chroma

# Where SecureRAG-Agent writes Phase 4 audit JSONL. `transfer/analyze_audit.py`
# reads from here to reconstruct per-layer ASR after replaying adversarial
# prompts to /agent/query.
AUDIT_LOG_DIR=../../SecureRAG-Agent/logs

# Ollama context-length workaround (until num_ctx is wired through
# ChatOllama + OutputScanner). Lets the 70B + llama-guard3 coexist in
# VRAM during transfer replay.
OLLAMA_CONTEXT_LENGTH=8192

# Anthropic API key for the Claude-driven mutation operator
# (attacks/hga/claude_operators.py). Required when running with
# --mutation-strategy claude. Get one at https://console.anthropic.com/.
# Rough cost on Opus 4.7 (default) with prompt caching: ~$3 per 50-pop
# x 20-gen smoke test (~1000 mutations); ~$60 per full 64-pop x 100-gen
# campaign (~6400 mutations). Sonnet 4.6 is roughly 1/3 those numbers.
ANTHROPIC_API_KEY=

# Model used by the Claude mutation operator. Default is claude-opus-4-7
# for highest-quality mutations. Override to claude-sonnet-4-6 if cost
# matters more than mutation quality.
# CLAUDE_MUTATION_MODEL=claude-opus-4-7
